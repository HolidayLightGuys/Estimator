# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored — never commit real keys.

# Server-side only. Used in src/app/api/geocode and src/app/api/property-image.
# Needs Geocoding API + Maps Static API (or Street View Static API) enabled.
# NEVER prefix this with NEXT_PUBLIC_ — it must stay server-side only.
GOOGLE_MAPS_API_KEY=

# Server-side only. Used in src/app/api/ai-suggest-lines for AI-suggested roofline points.
OPENAI_API_KEY=

# Safe to expose to the browser (NEXT_PUBLIC_ prefix required for client use).
NEXT_PUBLIC_APP_NAME=Holiday Light Guys Estimator

# Optional — placeholder for future Workiz integration (src/services/workiz.ts).
# Not called yet anywhere in the app.
WORKIZ_API_TOKEN=

# Optional but recommended once deployed anywhere reachable from the internet.
# Protects /api/workiz-webhook — set any random string here, and configure
# your email-forwarding service or Workiz's webhook feature to send the same
# value back as an `x-webhook-secret` header. Without this, anyone who finds
# the webhook URL could create fake drafts (though nothing worse than that).
WORKIZ_WEBHOOK_SECRET=
